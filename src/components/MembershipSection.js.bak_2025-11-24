import React, { useState, useRef } from 'react';
import { CheckCircle, QrCode } from 'lucide-react';

/*
  MembershipSection
  - Presents a holographic membership card and opens a "Cyber-Security Terminal" modal
    when the user clicks "Join The Waitlist".
  - If `GOOGLE_SCRIPT_URL` remains the placeholder, submissions are simulated (console.log + 2s delay).
  - If a real URL is provided, a POST with `mode: 'no-cors'` is attempted.
  - UI supports light and dark themes via `isDarkMode` prop.
*/
export default function MembershipSection({ isDarkMode = true, qrSrc = '/event-images/Events2025/csi_logo.png', qrAlt = 'Membership QR' }) {
  // Modal & form state
  const [showModal, setShowModal] = useState(false);
  const [loading, setLoading] = useState(false);
  const [success, setSuccess] = useState(false);
  const [error, setError] = useState(null);

  // form fields
  const [name, setName] = useState('');
  const [email, setEmail] = useState('');
  const [phone, setPhone] = useState('');
  const [year, setYear] = useState('FE');
  const [division, setDivision] = useState('A');
  const department = 'Computer Engineering';

  const formRef = useRef(null);

  // Replace this with your Google Apps Script web app URL when ready
  const GOOGLE_SCRIPT_URL = 'YOUR_WEB_APP_URL_HERE';

  // Theme tokens
  const rootBg = isDarkMode ? 'bg-slate-900/75 text-white' : 'bg-white text-slate-900';
  const cardBorder = isDarkMode ? 'border border-white/20' : 'border border-white/50';
  const descColor = isDarkMode ? 'text-slate-400' : 'text-slate-600';
  const badgeBg = isDarkMode ? 'bg-purple-700/20 text-purple-300' : 'bg-purple-100 text-purple-800';
  const pillBorder = isDarkMode ? 'ring-1 ring-white/6' : 'ring-1 ring-indigo-100';

  const openModal = () => { setShowModal(true); setSuccess(false); setError(null); };
  const closeModal = () => { setShowModal(false); setLoading(false); setSuccess(false); setError(null); };

  const handleSubmit = async (e) => {
    e && e.preventDefault();
    setError(null);
    if (!name.trim() || !email.trim() || !phone.trim()) {
      setError('Please complete required fields (name, email, contact).');
      return;
    }

    const payload = { name, email, phone, year, division, department };
    setLoading(true);

    if (GOOGLE_SCRIPT_URL === 'YOUR_WEB_APP_URL_HERE') {
      // Developer placeholder behavior: log & simulate delay
      console.log('Simulated submission payload:', payload);
      await new Promise((r) => setTimeout(r, 2000));
      setLoading(false);
      setSuccess(true);
      return;
    }

    try {
      const formData = new FormData();
      Object.entries(payload).forEach(([k, v]) => formData.append(k, v));

      await fetch(GOOGLE_SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        body: formData,
      });

      // No reliable response under no-cors; assume success after a short wait
      await new Promise((r) => setTimeout(r, 1000));
      setSuccess(true);
    } catch (err) {
      console.error('Submit error:', err);
      setError('Submission failed — try again later.');
    } finally {
      setLoading(false);
    }
  };

  return (
    <section className={`max-w-6xl mx-auto rounded-3xl p-6 md:p-10 ${rootBg} ${pillBorder} overflow-hidden`}>
      <style>{`
        .membership-grid{ display:grid; grid-template-columns:1fr; gap:1.25rem; }
        @media(min-width:900px){ .membership-grid{ grid-template-columns: 1fr 420px; } }
        .tilt { transition: transform 420ms cubic-bezier(.2,.9,.2,1); transform-style: preserve-3d; }
        .tilt:hover { transform: perspective(1000px) rotateY(12deg) rotateX(-6deg) translateZ(6px); }
        .holo-shine { transition: opacity 420ms ease; opacity:0; pointer-events:none; }
        .tilt:hover .holo-shine { opacity:1; }
        @keyframes scan { 0% { transform: translateY(-110%); } 50% { transform: translateY(110%);} 100%{ transform: translateY(-110%);} }
        .scan-line { position:absolute; left:0; right:0; height:3px; background:linear-gradient(90deg, rgba(var(--scan-color),0), rgba(var(--scan-color),0.9), rgba(var(--scan-color),0)); animation:scan 2.2s linear infinite; }
        .membership-card-outer { border-radius: 16px; padding: 3px; display:inline-block; background: linear-gradient(135deg, rgba(59,130,246,0.14), rgba(99,102,241,0.08)); box-shadow: 0 18px 50px rgba(59,130,246,0.12), inset 0 1px 0 rgba(255,255,255,0.02); transition: box-shadow 240ms ease, transform 240ms ease; backdrop-filter: blur(6px); }
        .membership-card-outer:hover { box-shadow: 0 28px 80px rgba(59,130,246,0.18), 0 6px 30px rgba(99,102,241,0.06); transform: translateY(-4px); }
        .membership-card-outer .tilt { border-radius: 14px; }
        .cta-btn{ position:relative; overflow:hidden; }
        .cta-btn .wipe { position:absolute; inset:0; transform:translateX(-100%); background:linear-gradient(90deg, rgba(255,255,255,0.06), rgba(255,255,255,0.12), rgba(255,255,255,0.06)); transition:transform .45s ease; }
        .cta-btn:hover .wipe { transform:translateX(0%); }
      `}</style>

      <div className="membership-grid">
        {/* Left marketing column */}
        <div className="px-2 md:px-6 py-4 md:py-6">
          <div className={`inline-flex items-center gap-3 px-3 py-1 rounded-full text-sm font-medium ${badgeBg} ${pillBorder}`}>
            <span className="text-lg">✨</span>
            <span>2025 Recruitment</span>
          </div>

          <h2 className="mt-6 text-3xl md:text-4xl font-extrabold leading-tight">
            Unlock Your <span className="bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-purple-500">Tech Potential</span>
          </h2>

          <p className={`mt-4 max-w-xl ${descColor} text-base`}>Join the elite network of student innovators, gain hands-on experience, access industry mentors, and participate in exclusive workshops and events.</p>

          <ul className="mt-6 space-y-3">
            <li className="flex items-start gap-3">
              <CheckCircle className="w-6 h-6 text-emerald-400 mt-0.5 flex-shrink-0" />
              <span className={isDarkMode ? 'text-slate-100' : 'text-slate-800'}>Exclusive workshops & mentorship</span>
            </li>
            <li className="flex items-start gap-3">
              <CheckCircle className="w-6 h-6 text-emerald-400 mt-0.5 flex-shrink-0" />
              <span className={isDarkMode ? 'text-slate-100' : 'text-slate-800'}>Priority access to events and internships</span>
            </li>
            <li className="flex items-start gap-3">
              <CheckCircle className="w-6 h-6 text-emerald-400 mt-0.5 flex-shrink-0" />
              <span className={isDarkMode ? 'text-slate-100' : 'text-slate-800'}>Community projects and hackathons</span>
            </li>
          </ul>

          <div className="mt-6">
            <button onClick={openModal} className="cta-btn relative inline-flex items-center gap-3 px-6 py-3 rounded-lg font-semibold text-white bg-gradient-to-r from-cyan-500 to-indigo-600 shadow-md">
              <span className="wipe" aria-hidden />
              Join The Waitlist
            </button>
          </div>
        </div>

        {/* Right interactive holographic ID card */}
        <div className="flex items-center justify-center px-2 md:px-6">
          <div className="membership-card-outer rounded-3xl p-1">
            <div className={`tilt w-64 md:w-72 rounded-2xl p-4 ${isDarkMode ? 'bg-slate-900/40 text-white' : 'bg-white/60 text-slate-900'} ${cardBorder} relative overflow-hidden`}>
              {/* Holographic shine overlay */}
              <div className="holo-shine absolute inset-0 pointer-events-none" style={{background: 'linear-gradient(120deg, rgba(255,255,255,0.06) 0%, rgba(99,102,241,0.06) 35%, rgba(56,189,248,0.04) 70%, rgba(255,255,255,0.02) 100%)'}} />

              <div className="flex flex-col items-center gap-4">
                <div className="w-full flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <div className="w-10 h-10 rounded-md bg-gradient-to-tr from-cyan-400 to-purple-500 flex items-center justify-center font-bold text-sm">CSI</div>
                    <div>
                      <div className="text-sm font-semibold">CSI WIET</div>
                      <div className="text-xs text-slate-400">Member ID</div>
                    </div>
                  </div>
                  <div className="text-xs text-slate-400">VIP</div>
                </div>

                <div className="w-full bg-transparent rounded-lg p-2">
                  <div className={`bg-white ${isDarkMode ? 'bg-white/6' : 'bg-white'} rounded-md p-3 relative flex items-center justify-center`}>
                    <div className="w-28 h-28 bg-slate-100/10 rounded-md flex items-center justify-center">
                      {qrSrc ? (
                        <img src={qrSrc} alt={qrAlt} className="w-24 h-24 object-contain" />
                      ) : (
                        <QrCode className={`${isDarkMode ? 'text-slate-200' : 'text-slate-700'} w-12 h-12`} />
                      )}
                    </div>

                    {/* scan overlay */}
                    <div className="absolute inset-3 overflow-hidden" style={{ ['--scan-color']: qrSrc ? '59,130,246' : (isDarkMode ? '239,68,68' : '59,130,246') }}>
                      <div className="scan-line" />
                    </div>
                  </div>
                </div>

                <div className="w-full flex items-center justify-between text-xs">
                  <div className="text-xs">Status: <span className="inline-flex items-center gap-2"><span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" /> Accepting Applications</span></div>
                  <div className="text-xs text-slate-400">Expires: Dec 2025</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Modal: Cyber-Security Terminal */}
      {showModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center">
          <div className="absolute inset-0 bg-black/60 backdrop-blur-sm" onClick={closeModal} />

          <div className={`relative w-full max-w-xl mx-4 rounded-xl ${isDarkMode ? 'bg-slate-950 text-white border border-slate-800' : 'bg-white text-slate-900 border border-slate-200'} shadow-2xl z-60`}> 
            {/* Terminal header */}
            <div className={`px-4 py-2 ${isDarkMode ? 'bg-neutral-900/60 border-b border-slate-800' : 'bg-gray-100/60 border-b border-slate-200'} rounded-t-xl font-mono text-sm flex items-center justify-between`}> 
              <div className="flex items-center gap-3">
                <span className={`h-2 w-2 rounded-full ${isDarkMode ? 'bg-red-500' : 'bg-red-600'}`} />
                <span className={`h-2 w-2 rounded-full ${isDarkMode ? 'bg-amber-400' : 'bg-amber-500'}`} />
                <span className={`h-2 w-2 rounded-full ${isDarkMode ? 'bg-emerald-400' : 'bg-emerald-500'}`} />
                <span className="ml-3 text-xs text-slate-400">root@csi-server: ~ / join-request</span>
              </div>
              <button onClick={closeModal} className="text-xs text-slate-400 hover:text-white px-2">Close</button>
            </div>

            <div className="p-6">
              {!success ? (
                <form ref={formRef} onSubmit={handleSubmit} className="space-y-4">
                  <div className="font-mono text-sm text-slate-300">&gt; Initializing Registration Protocol....</div>

                  <div className="grid grid-cols-1 gap-3">
                    <label className="text-xs">Candidate Name</label>
                    <input value={name} onChange={(e)=>setName(e.target.value)} className={`${isDarkMode ? 'bg-slate-900 text-white border border-slate-800' : 'bg-white text-slate-900 border border-slate-200'} rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-cyan-400`} placeholder="Full name" />

                    <label className="text-xs">Email Address</label>
                    <input type="email" value={email} onChange={(e)=>setEmail(e.target.value)} className={`${isDarkMode ? 'bg-slate-900 text-white border border-slate-800' : 'bg-white text-slate-900 border border-slate-200'} rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-green-400`} placeholder="you@college.edu" />

                    <label className="text-xs">Contact Number</label>
                    <input type="tel" value={phone} onChange={(e)=>setPhone(e.target.value)} className={`${isDarkMode ? 'bg-slate-900 text-white border border-slate-800' : 'bg-white text-slate-900 border border-slate-200'} rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-cyan-400`} placeholder="0251-xxxxxxx" />

                    <div className="grid grid-cols-2 gap-3">
                      <div>
                        <label className="text-xs">Year</label>
                        <select value={year} onChange={(e)=>setYear(e.target.value)} className={`${isDarkMode ? 'bg-slate-900 text-white border border-slate-800' : 'bg-white text-slate-900 border border-slate-200'} rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-cyan-400 w-full`}>
                          <option>FE</option>
                          <option>SE</option>
                          <option>TE</option>
                          <option>BE</option>
                        </select>
                      </div>

                      <div>
                        <label className="text-xs">Division</label>
                        <select value={division} onChange={(e)=>setDivision(e.target.value)} className={`${isDarkMode ? 'bg-slate-900 text-white border border-slate-800' : 'bg-white text-slate-900 border border-slate-200'} rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-cyan-400 w-full`}>
                          <option>A</option>
                          <option>C</option>
                        </select>
                      </div>
                    </div>

                    <div>
                      <label className="text-xs">Department</label>
                      <div className={`${isDarkMode ? 'bg-slate-900 text-slate-200 border border-slate-800' : 'bg-gray-50 text-slate-800 border border-slate-200'} rounded px-3 py-2`}>{department}</div>
                    </div>
                  </div>

                  {error && <div className="text-sm text-rose-400">{error}</div>}

                  <div className="flex items-center gap-3 justify-between">
                    <div className="flex items-center gap-3">
                      <button type="submit" disabled={loading} className={`inline-flex items-center gap-2 px-4 py-2 rounded font-semibold ${loading ? 'bg-slate-700' : 'bg-cyan-500 hover:bg-cyan-400 text-white'}`}>
                        {loading ? (
                          <svg className="animate-spin -ml-1 mr-2 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>
                        ) : null}
                        {loading ? 'Executing...' : 'Execute Request'}
                      </button>

                      <button type="button" onClick={closeModal} className="px-3 py-2 rounded bg-slate-700 text-white">Abort</button>
                    </div>

                    <div className="text-xs text-slate-400 font-mono">terminal://v1</div>
                  </div>
                </form>
              ) : (
                <div className="text-center py-8">
                  <div className="flex items-center justify-center mb-6">
                    <div className="rounded-full bg-emerald-50 p-4">
                      <CheckCircle className="w-12 h-12 text-emerald-600" />
                    </div>
                  </div>
                  <h3 className="text-2xl font-bold text-emerald-400">Permission Granted</h3>
                  <p className="mt-2 text-slate-400">Your request has been recorded. Welcome to CSI.</p>
                  <div className="mt-6">
                    <button onClick={closeModal} className="px-4 py-2 rounded bg-emerald-500 text-black font-semibold">Close Terminal</button>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      )}

    </section>
  );
}
